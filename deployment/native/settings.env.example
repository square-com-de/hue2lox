# Documentation only. install.sh writes concrete absolute paths.
BIND_HOST=127.0.0.1
PORT=18443
HUE_PUBLIC_URL=https://127.0.0.1:18443
HUE_STATE_DIR=/var/lib/hue2lox
HUE_REGISTRY_FILE=/var/lib/hue2lox/registry.json
HUE_ADMIN_AUTH_FILE=/var/lib/hue2lox/admin_auth.json
HUE_CONTROL_TOKEN_FILE=/etc/hue2lox/secrets/control_token
HUE_CA_FILE=/opt/hue2lox/current/trust/huebridge-ca.pem
TLS_CERT=/etc/hue2lox/certs/server.crt
TLS_KEY=/etc/hue2lox/certs/server.key
HUE_LEGACY_ENABLED=0
HUE_WRITES_ENABLED=0
HUE_COLOR_ENABLED=0
HUE_WHITE_ENABLED=0
PYTHONDONTWRITEBYTECODE=1
